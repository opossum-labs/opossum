<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <DirectoryRef Id="INSTALLDIR">
            <Component Id="OpossumBackendComponent" Guid="*">
                <File Id="OpossumBackendExe"
                    Name="opossum_backend.exe"
                    Source="@@RELEASE_DIR@@\opossum_backend.exe" 
                    KeyPath="yes" />
            </Component>
            <Component Id="OpossumCoreComponent" Guid="*">
                <File Id="OpossumCoreExe"
                    Name="opossum_core.exe"
                    Source="@@RELEASE_DIR@@\opossum_cli.exe" 
                    KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <ComponentGroup Id="HelperBinariesComponentGroup">
            <ComponentRef Id="OpossumBackendComponent" />
            <ComponentRef Id="OpossumCoreComponent" />
        </ComponentGroup>
    </Fragment>
</Wix>